# Copy to /etc/urrise-console/urrise-console.env and protect with chmod 600.
# Never commit a real .env file or replace these placeholders with secrets.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:////var/lib/urrise-console/console.db
SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=console.example.com
BOOTSTRAP_ADMIN_USERNAME=admin
# Used only for one-time init-admin. Remove after creating the first admin.
BOOTSTRAP_ADMIN_PASSWORD=replace-this-with-a-unique-long-random-password
